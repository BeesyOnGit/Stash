# Production .env — copy to the deploy folder on the VPS as `.env` (never commit it).
# Used by docker compose (port) and passed to the API container.

PORT=8080
# Set to 127.0.0.1 once a reverse proxy (Caddy / Nginx) serves the API over HTTPS
API_BIND=0.0.0.0
# An empty huddle (playlist, chat) is discarded after this many seconds
EMPTY_TTL_SECS=300
RUST_LOG=huddle_api=info,tower_http=info

# Voice chat (LiveKit). The API signs tokens with the same key and secret.
# Make a secret with: openssl rand -base64 32
LIVEKIT_API_KEY=huddle
LIVEKIT_API_SECRET=change-me
# Public signalling URL: the reverse proxy serves 127.0.0.1:7880 here over TLS.
# Open 7881/tcp, 7882/udp and 3478/udp on the VPS.
LIVEKIT_URL=wss://voice.inovsoft.online
