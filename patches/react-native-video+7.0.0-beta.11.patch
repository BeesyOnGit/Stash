+/**
+ * The session's view of a player: one song, but ⏮ ⏭ always on offer and moving through the
+ * app's queue (CustomMediaNotificationProvider.onSkip). Lock screens, Bluetooth headsets and
+ * car stereos only use these standard commands, not the notification's own buttons.
+ */
+@OptIn(UnstableApi::class)
+private class QueuePlayer(player: Player) : ForwardingPlayer(player) {
+  override fun getAvailableCommands(): Player.Commands =
+    super.getAvailableCommands().buildUpon()
+      .addAll(
+        COMMAND_SEEK_TO_PREVIOUS,
+        COMMAND_SEEK_TO_PREVIOUS_MEDIA_ITEM,
+        COMMAND_SEEK_TO_NEXT,
+        COMMAND_SEEK_TO_NEXT_MEDIA_ITEM,
+      )
+      .build()
+
+  override fun isCommandAvailable(command: Int) = availableCommands.contains(command)
+
+  override fun seekToPrevious() = skip("previous") { super.seekBack() }
+  override fun seekToPreviousMediaItem() = skip("previous") { super.seekBack() }
+  override fun seekToNext() = skip("next") { super.seekForward() }
+  override fun seekToNextMediaItem() = skip("next") { super.seekForward() }
+
+  private inline fun skip(type: String, fallback: () -> Unit) {
+    if (CustomMediaNotificationProvider.onSkip?.invoke(type) != true) fallback()
+  }
+}
